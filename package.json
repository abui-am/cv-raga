{
  "name": "cv-raga",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.14.0 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "prisma generate && next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint",
    "format": "prettier --write app components features lib scripts tests *.ts *.json *.yaml README.md",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "tsx scripts/test-database.ts && playwright test",
    "db:up": "docker-compose --env-file .env.local up -d --build --wait db",
    "db:down": "docker-compose --env-file .env.local down",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@hookform/resolvers": "^6.0.0",
    "@lukemorales/query-key-factory": "^1.3.4",
    "@mobily/ts-belt": "^3.13.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@react-pdf/renderer": "^4.9.0",
    "@tanstack/react-query": "^5.104.5",
    "better-auth": "^1.7.15",
    "docx": "^9.14.0",
    "dotenv": "^18.0.9",
    "lucide-react": "^1.61.0",
    "mammoth": "^1.13.0",
    "next": "16.4.3",
    "openai": "^7.43.0",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "5.4.296",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.91.0",
    "server-only": "0.0.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "prettier": "^3.9.10",
    "prisma": "7.10.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@11.17.0"
}
